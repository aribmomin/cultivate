# Organic Farming Platform Server Environment Configuration
# Copy this file to .env and configure your variables

# Server Port (default 5000)
PORT=5000

# Node Environment: development | production | test
NODE_ENV=development

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/organic_farming?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/organic_farming
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/organic_farming?retryWrites=true&w=majority

# JWT Secret & Expiration for Authentication
JWT_SECRET=terralearn_super_secure_jwt_secret_change_in_production_2026
JWT_EXPIRES_IN=7d

